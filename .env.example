## Gemini 
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

APP_NAME="FabriCore AI"
ENVIRONMENT=development

# Handover generation — Groq
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
# V5 evaluation — OpenAI
# EVAL_LLM_PROVIDER=openai
# EVAL_LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=
EVAL_LLM_PROVIDER=groq
EVAL_LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=

# Data and retrieval
DATA_DIR=data/synthetic
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DOCUMENT_DIR=data/synthetic/documents
VECTOR_STORE_DIR=data/vector_store
